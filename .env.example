# Public Yamtrack origin — only used for poster image URLs (no auth needed)
PUBLIC_YAMTRACK_URL=

# Vercel API host used by the site build (api/anilist.ts, api/yamtrack.ts).
# Required for GitHub Pages: https://emilumiq-list-api.vercel.app
# Also set it as a GitHub Actions variable PUBLIC_API_URL.
PUBLIC_API_URL=
