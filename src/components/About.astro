---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import Flags from './Flags.astro';
import { profile } from '../data/profile';
---

<div class="flex flex-col gap-4 py-1">
  <div class="flex items-center gap-3">
    <Image
      src={avatar}
      alt=""
      width={56}
      height={56}
      class="size-14 shrink-0 rounded-full ring-1 ring-line"
      loading="eager"
    />
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">
      {profile.name} <span class="align-middle text-lg sm:text-xl">{profile.emoji}</span>
    </h1>
  </div>
  <div class="flex max-w-xl flex-col gap-2 text-ui leading-relaxed text-muted">
    <p>
      {profile.intro[0]}
      <span class="text-faint"> · she/her</span>
      <span class="ml-1 inline-flex items-center gap-1 align-middle"><Flags /></span>
    </p>
    <p>
      {profile.intro[1]}{' '}
      <span
        class="spoiler -my-1 px-1 py-1 text-accent data-[revealed=true]:select-text data-[revealed=true]:[filter:none]"
        tabindex="0"
        role="button"
        aria-pressed="false"
        data-spoiler
        title="click to reveal"
        >{profile.spoiler}</span
      >
    </p>
    <p>{profile.intro[2]}</p>
  </div>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLSpanElement>('[data-spoiler]')) {
    const toggle = () => {
      const revealed = el.dataset.revealed !== 'true';
      el.dataset.revealed = String(revealed);
      el.setAttribute('aria-pressed', String(revealed));
    };
    el.addEventListener('click', toggle);
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
  }
</script>
