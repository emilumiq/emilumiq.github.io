---
const year = new Date().getFullYear();
import Icon from './Icon.astro';
---

<footer class="mt-12 border-t border-line">
	<div class="mx-auto max-w-3xl px-6 py-8 text-base text-muted">

		<div class="mb-6">
			<p class="mb-3 text-sm text-muted/70">telegram</p>
			<div class="flex flex-wrap gap-3">
				<a href="https://t.me/+1gd8fQTSZYAxYjhi" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-accent hover:text-accent-strong"><Icon name="send" class="h-3.5 w-3.5" />blog</a>
				<a href="https://t.me/emilumiq" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-accent hover:text-accent-strong"><Icon name="send" class="h-3.5 w-3.5" />dm</a>
				<a href="https://t.me/neomovies_news" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-accent hover:text-accent-strong"><Icon name="send" class="h-3.5 w-3.5" />neo</a>
			</div>
		</div>

		<div class="mb-6">
			<p class="mb-3 text-sm text-muted/70">links</p>
