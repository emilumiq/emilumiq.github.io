				<a href="https://astro.build" target="_blank" rel="noopener"><img src="/astro-88x31.png" alt="built with astro" width="88" height="31"></a>
				<img title="trans lesbi" style="image-rendering: pixelated;" src="https://badge.les.bi/88x31/trans/lesbi/half/outset.png" width="88" height="31">
				<img src="/animegay.gif" alt="animegay" width="88" height="31">
				<a href="https://nixos.org" target="_blank" rel="noopener"><img src="/nixos-badge.gif" alt="nixos" width="88" height="31"></a>
