---
import Icon from './Icon.astro';

const year = new Date().getFullYear();

const link =
  'inline-flex items-center gap-1.5 text-accent transition-colors hover:text-accent-strong';
---

<footer class="mt-3 border-t border-line">
  <div class="mx-auto flex w-full max-w-page flex-col gap-5 px-4 py-6 text-meta text-muted">
    <div>
      <p class="mb-2 text-caption text-faint">telegram</p>
      <div class="flex flex-wrap gap-x-4 gap-y-2">
        <a href="https://t.me/+1gd8fQTSZYAxYjhi" target="_blank" rel="noopener noreferrer" class={link}><Icon name="send" class="h-3.5 w-3.5" />blog</a>
        <a href="https://t.me/emilumiq" target="_blank" rel="noopener noreferrer" class={link}><Icon name="send" class="h-3.5 w-3.5" />dm</a>
        <a href="https://t.me/neomovies_news" target="_blank" rel="noopener noreferrer" class={link}><Icon name="send" class="h-3.5 w-3.5" />neo</a>
      </div>
    </div>

    <div>
      <p class="mb-2 text-caption text-faint">links</p>
      <div class="flex flex-wrap gap-x-4 gap-y-2">
        <a href="https://github.com/emilumiq" target="_blank" rel="noopener noreferrer" class={link}><Icon name="github" class="h-3.5 w-3.5" />github</a>
        <a href="https://git.neome.uk/emilumiq" target="_blank" rel="noopener noreferrer" class={link}><span class="h-3.5 w-3.5 bg-current" style="-webkit-mask: url(/forgejo.svg) center / contain no-repeat; mask: url(/forgejo.svg) center / contain no-repeat;" aria-hidden="true"></span>forgejo</a>
      </div>
    </div>

    <div>
      <p class="mb-2 text-caption text-faint">visitors</p>
      <a href="https://count.getloli.com/" target="_blank" rel="noopener" title="moe counter">
        <img
          src="https://count.getloli.com/@emilumiq.github.io?theme=moebooru"
          alt="visitor counter"
          width="315"
          height="100"
          class="h-auto max-w-full"
          loading="lazy"
          style="image-rendering: pixelated;"
          onerror="this.closest('div').style.display='none'"
        />
      </a>
    </div>

    <div>
      <p class="mb-2 text-caption text-faint">badges</p>
      <div class="flex flex-wrap items-center gap-x-1 gap-y-1.5">
        <button type="button" data-badge-copy class="relative rounded-[2px] ring-1 ring-accent/40 transition-shadow hover:ring-accent" aria-label="Copy my badge code" title="click to copy">
          <img src="/emilumiq-88x31.gif" alt="emilumiq" width="88" height="31" style="image-rendering: pixelated;" />
        </button>
        <a href="https://d7tun6.neome.uk" target="_blank" rel="noopener"><img src="/d7tun6-88x31.gif" alt="d7tun6" width="88" height="31" /></a>
        <a href="https://myslivets.com/" target="_blank" rel="noopener"><img src="/myslivets-88x31.png" alt="myslivets" width="88" height="31" /></a>
        <a href="https://otomir23.me/" target="_blank" rel="noopener"><img src="/otomir23-88x31.png" alt="otomir23" width="88" height="31" style="image-rendering: pixelated;" /></a>
        <a href="https://astro.build" target="_blank" rel="noopener"><img src="/astro-88x31.png" alt="built with astro" width="88" height="31" /></a>
        <img title="trans lesbi" style="image-rendering: pixelated;" src="https://badge.les.bi/88x31/trans/lesbi/half/outset.png" width="88" height="31" alt="trans lesbi" />
        <img src="/animegay.gif" alt="animegay" width="88" height="31" />
        <a href="https://nixos.org" target="_blank" rel="noopener"><img src="/nixos-badge.gif" alt="nixos" width="88" height="31" /></a>
        <img src="/macos-88x31.gif" alt="macos" width="88" height="31" />
        <a href="https://jellyfin.org" target="_blank" rel="noopener"><img src="/jellyfin-88x31.gif" alt="jellyfin" width="88" height="31" /></a>
        <img src="/yuri-yukiyuri.gif" alt="yuri" width="88" height="31" />
        <img src="/portal-88x31.png" alt="portal" width="88" height="31" />
        <img src="/yuri-88x31.gif" alt="yuri" width="88" height="31" />
        <img src="/yuri-88x31-2.gif" alt="yuri" width="88" height="31" />
        <img src="/kangel-88x31.gif" alt="kangel" width="88" height="31" />
        <img src="/manga-badge.gif" alt="manga mais anime" width="88" height="31" />
      </div>
    </div>

    <p class="text-caption text-faint">
      {year} Emily Aoi · built with <a class="text-accent transition-colors hover:text-accent-strong" href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
    </p>
  </div>
</footer>

<script>
  import { copyText } from '../lib/clipboard';
  import { showToast } from '../lib/toast';

  const badgeCode =
    '<a href="https://emilumiq.github.io"><img src="https://emilumiq.github.io/emilumiq-88x31.gif" alt="emilumiq" width="88" height="31"></a>';

  const btn = document.querySelector<HTMLButtonElement>('[data-badge-copy]');
  btn?.addEventListener('click', () => {
    void copyText(badgeCode).then((ok) => {
      showToast(ok ? 'badge code copied' : 'copy failed');
    });
  });
</script>
