---
import Flags from './Flags.astro';
import { profile } from '../data/profile';
---

<section id="about" class="scroll-mt-20">
	<h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
		{profile.name} <span class="align-middle text-2xl sm:text-3xl">{profile.emoji}</span>
	</h1>

	<div class="mt-6 max-w-xl space-y-3 leading-relaxed text-muted">
		<p>
			{profile.intro[0]}
			<span class="text-muted/60"> · she/her</span>
			<span class="inline-flex items-center gap-1 align-middle ml-1"><Flags /></span>
		</p>
		<p>{profile.intro[1]}</p>
		<p>
			{profile.intro[2]}
			<span class="spoiler text-accent-soft/90" tabindex="0" role="button" title="click to reveal"
				>{profile.spoiler}</span
			>
		</p>
		<p>{profile.intro[3]}</p>
	</div>
</section>

<script>
	for (const el of document.querySelectorAll<HTMLSpanElement>('.spoiler')) {
		const toggle = () => el.classList.toggle('revealed');
		el.addEventListener('click', toggle);
		el.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				toggle();
			}
		});
	}
</script>
