};

interface Props {
	name: keyof typeof icons | string;
	class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;
const paths = icons[name] ?? '';
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={paths}
/>
