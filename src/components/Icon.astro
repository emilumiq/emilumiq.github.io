	'arrow-up-right': '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>',
	code: '<path d="m8 9-4 3 4 3M16 9l4 3-4 3M14 5l-4 14"/>',
	tv: '<rect width="20" height="14" x="2" y="7" rx="2"/><path d="m17 2-5 5-5-5"/>',
	telegram: '<path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>',
	rutracker: '<circle cx="12" cy="12" r="9"/><path d="M8 8h5a3 3 0 0 1 0 6H8zM13 14l3 3"/>',
	nnmclub: '<path d="M4 6h16v12H4z"/><path d="M8 6v12M16 6v12M4 10h16M4 14h16"/>',
	forgejo: '<path d="M5 4h14v16H5z"/><path d="m9 8 6 4-6 4z"/>',
