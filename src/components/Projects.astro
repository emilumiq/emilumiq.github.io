---
import Icon from './Icon.astro';
import { projects } from '../data/profile';

const tagIcons: Record<string, string> = {
  'next.js': '/nextjs.svg',
  typescript: '/typescript.svg',
  bun: '/bun.svg',
  elysia: '/elysia.svg',
  auth: '/typescript.svg',
  go: '/go.svg',
  vue: '/vue.svg',
};
---

<ol class="flex flex-col">
  {
    projects.map((p) => (
      <li class="group/row flex items-center gap-2 rounded-md px-2 py-2.5 transition-colors hover:bg-surface-hover">
        <a class="min-w-0 flex-1" href={p.siteUrl} target="_blank" rel="noopener noreferrer">
          <span class="flex items-center gap-2">
            <span class="truncate text-ui font-semibold transition-colors group-hover/row:text-accent">
              {p.name}
            </span>
            <span class="flex shrink-0 items-center gap-1.5">
              {p.tags.map((t) => (
                <img
                  src={tagIcons[t] ?? '/typescript.svg'}
                  alt={t}
                  title={t}
                  loading="lazy"
                  class="tech-icon h-4 w-4 object-contain"
                />
              ))}
            </span>
          </span>
          <span class="mt-0.5 block truncate text-caption text-faint">{p.description}</span>
        </a>
        <a
          class="grid size-9 shrink-0 place-items-center rounded-md text-faint transition-colors hover:text-accent"
          href={p.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Open ${p.name} source code`}
          title="Source code"
        >
          <Icon name="code" class="h-4 w-4" />
        </a>
      </li>
    ))
  }
</ol>
