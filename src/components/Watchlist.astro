---
import { watchlist } from '../data/profile';
---

<section id="watching" class="scroll-mt-20">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <h2 class="text-2xl font-semibold text-foreground">{watchlist.title}</h2>
    <a href="/watching" class="text-base text-accent hover:text-accent-strong transition-colors">watch all</a>
  </div>
  <p class="mt-1 text-base text-muted">{watchlist.note}</p>
  <div class="mt-1 flex flex-wrap gap-3 text-xs text-muted/70">
    <span class="inline-flex items-center gap-1"><span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span> watching</span>
    <span class="inline-flex items-center gap-1"><span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span> completed</span>
    <span class="inline-flex items-center gap-1"><span class="inline-block h-1.5 w-1.5 rounded-full bg-indigo-400"></span> planned</span>
  </div>

  <div class="mt-5 relative">
    <button id="scroll-left" class="scroll-arrow-btn is-hidden text-accent absolute -left-8 top-1/3 -translate-y-1/2 hidden sm:block z-10" aria-label="Scroll left">‹</button>
    <div id="watchlist-grid" class="watchlist-scroller flex gap-3 overflow-x-auto pb-2 px-1">
      {Array.from({ length: watchlist.limit }).map(() => (
        <div class="animate-pulse-soft shrink-0 w-28 sm:w-36">
          <div class="aspect-[2/3] bg-surface" />
          <div class="mt-2 h-3.5 w-3/4 bg-surface" />
          <div class="mt-1.5 h-3 w-1/3 bg-surface" />
        </div>
      ))}
    </div>
    <button id="scroll-right" class="scroll-arrow-btn is-hidden text-accent absolute -right-8 top-1/3 -translate-y-1/2 hidden sm:block z-10" aria-label="Scroll right">›</button>
  </div>
</section>

<script>
  import { createCard, showFallback } from '../lib/cards';
  import { fetchAll } from '../lib/yamtrack';
  import { watchlist } from '../data/profile';

  const grid = document.getElementById('watchlist-grid')!;
  const leftBtn = document.getElementById('scroll-left')!;
  const rightBtn = document.getElementById('scroll-right')!;
  const SCROLL_AMOUNT = 220;

  function updateArrows() {
    const maxScroll = grid.scrollWidth - grid.clientWidth;
    leftBtn.classList.toggle('is-hidden', grid.scrollLeft <= 0);
    rightBtn.classList.toggle('is-hidden', grid.scrollLeft >= maxScroll - 2);
  }

  leftBtn.addEventListener('click', () => {
    grid.scrollBy({ left: -SCROLL_AMOUNT, behavior: 'smooth' });
  });

  rightBtn.addEventListener('click', () => {
    grid.scrollBy({ left: SCROLL_AMOUNT, behavior: 'smooth' });
  });

  grid.addEventListener('scroll', updateArrows);

  window.addEventListener('wheel', (event) => {
    const scroller = (event.target as HTMLElement).closest?.('#watchlist-grid') as HTMLElement | null;
    if (scroller && event.shiftKey) {
      event.preventDefault();
      scroller.scrollLeft += event.deltaY;
      setTimeout(updateArrows, 50);
    }
  }, { passive: false });

  fetchAll()
    .then((items) => {
      const top = items.slice(0, watchlist.limit);
      if (top.length === 0) {
        showFallback(grid, 'nothing here right now');
        return;
      }
      grid.className = 'watchlist-scroller flex gap-3 overflow-x-auto pb-2 px-1';
      grid.replaceChildren(
        ...top.map((e) => createCard(e, 'scroller')),
      );
      updateArrows();
    })
    .catch(() => showFallback(grid, 'could not load the watchlist'));
</script>
