---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---

<Base title="404 ~ nowhere to be found" description="oops, this page doesn't exist :3">
  <div class="flex min-h-screen flex-col">
    <main class="mx-auto flex w-full max-w-xl flex-1 flex-col items-center justify-center px-6 pt-16 pb-6 text-center">
      <p class="mb-4 font-mono text-sm text-muted">404 · file not found</p>

      <img
        src="/404.jpeg"
        alt="madoka says 404 file not found"
        width="500"
        height="375"
        class="w-full max-w-md rounded-2xl border border-line object-cover shadow-lg"
        loading="eager"
        fetchpriority="high"
      />

      <h1 class="mt-6 text-3xl font-bold text-foreground">oops, nowhere to be found :3</h1>
      <p class="mt-2 text-muted">this page wandered off like a magical girl — let's get you back home</p>

      <a
        href="/"
        class="btn-accent mt-6 inline-flex items-center gap-2 rounded-full px-6 py-2.5 text-base font-medium"
      >
        ← back home
      </a>
    </main>

    <Footer />
  </div>
</Base>
