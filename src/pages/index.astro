---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Panel from '../components/Panel.astro';
import SkeletonRail from '../components/SkeletonRail.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Footer from '../components/Footer.astro';
import { watchlist, reading } from '../data/profile';
---

<Base>
  <div class="mx-auto flex w-full max-w-page justify-end px-4 pt-2">
    <ThemeToggle />
  </div>
  <main class="mx-auto flex w-full max-w-page flex-1 flex-col gap-3 px-4 py-2 pb-5">
    <div class="grid grid-cols-1 gap-3 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <Panel id="about" class="min-w-0 scroll-mt-16" title="about" icon="user">
        <About />
      </Panel>
      <Panel id="projects" class="min-w-0 scroll-mt-16" title="projects" icon="code">
        <Projects />
      </Panel>
    </div>

    <Panel id="watching" class="scroll-mt-16" title={watchlist.title} icon="tv" href="/watching">
      <SkeletonRail id="watchlist-grid" label="watching" wide count={10} />
    </Panel>

    <Panel id="reading" class="scroll-mt-16" title={reading.title} icon="book-open" href="/reading">
      <SkeletonRail id="reading-grid" label="reading" count={10} />
    </Panel>
  </main>
  <Footer />
</Base>

<script>
  import { initThemeToggle } from '../lib/icons';
  import { createCard, showFallback, sortWatchlist, type Entry } from '../lib/cards';
  import { fetchAniList } from '../lib/anilist';
  import { watchlist, reading } from '../data/profile';

  initThemeToggle();

  const fill = (id: string, items: Entry[], empty: string) => {
    const track = document.getElementById(id)!;
    if (items.length === 0) {
      showFallback(track, empty);
    } else {
      track.replaceChildren(...items.map((e) => createCard(e)));
    }
    track.dispatchEvent(new Event('scroll'));
  };

  const loadLists = () => {
    void fetchAniList()
      .then((anilist) => {
        fill('watchlist-grid', sortWatchlist(anilist.anime).slice(0, watchlist.limit), 'nothing here right now');
        fill('reading-grid', sortWatchlist(anilist.manga).slice(0, reading.limit), 'nothing here right now');
      })
      .catch(() => {
        const fail = (id: string, message: string) => {
          const track = document.getElementById(id)!;
          showFallback(track, message, loadLists);
          track.dispatchEvent(new Event('scroll'));
        };
        fail('watchlist-grid', 'could not load the watchlist');
        fail('reading-grid', 'could not load the reading list');
      });
  };
  loadLists();
</script>
