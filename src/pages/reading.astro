---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';

const statuses = [
  { value: '', label: 'All' },
  { value: 'In progress', label: 'Reading' },
  { value: 'Completed', label: 'Completed' },
  { value: 'Planning', label: 'Planning' },
  { value: 'Paused', label: 'Paused' },
  { value: 'Dropped', label: 'Dropped' },
];
---

<Base title="Reading · Emily">
  <div class="flex min-h-screen flex-col">
    <div class="mx-auto flex w-full max-w-3xl justify-end px-6 pt-8">
      <button id="theme-toggle" class="icon-button" type="button" aria-label="Toggle theme" title="Toggle theme"></button>
    </div>

    <main class="mx-auto w-full max-w-3xl flex-1 px-6 py-10 sm:py-14">
      <a href="/" class="inline-flex text-base text-accent hover:text-accent-strong">← back</a>

      <div class="mt-8 flex items-end justify-between border-b border-line pb-4">
        <div>
          <h1 class="text-4xl font-bold text-foreground">reading</h1>
          <div class="mt-1 flex flex-wrap gap-3 text-xs text-muted/70">
            <span class="inline-flex items-center gap-1"><span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span> reading</span>
            <span class="inline-flex items-center gap-1"><span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span> completed</span>
            <span class="inline-flex items-center gap-1"><span class="inline-block h-1.5 w-1.5 rounded-full bg-indigo-400"></span> planned</span>
            <span class="inline-flex items-center gap-1"><span class="inline-block h-1.5 w-1.5 rounded-full bg-amber-500"></span> paused</span>
            <span class="inline-flex items-center gap-1"><span class="inline-block h-1.5 w-1.5 rounded-full bg-rose-400"></span> dropped</span>
          </div>
        </div>
        <span id="list-status" class="text-sm text-muted" aria-live="polite">loading…</span>
      </div>

      <nav class="mt-6 flex flex-wrap gap-5" aria-label="Status filter">
        {statuses.map((s) => (
          <button
            data-status={s.value}
            class:list={['status-tab', 'text-sm', 'font-medium', s.value === '' ? 'status-tab-active' : 'status-tab-inactive']}
          >
            {s.label}
          </button>
        ))}
      </nav>

      <div id="list-grid" class="mt-6 grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-4"></div>
    </main>

    <Footer />
  </div>
</Base>

<script>
  import { initThemeToggle } from '../lib/icons';
  import { mountListPage } from '../lib/listPage';
  import { sortWatchlist } from '../lib/cards';
  import { fetchAniList } from '../lib/anilist';

  initThemeToggle();

  mountListPage({
    load: async () => {
      const anilist = await fetchAniList().catch(() => null);
      return sortWatchlist(anilist?.manga ?? []);
    },
    errorMessage: 'could not load the reading list',
  });
</script>
