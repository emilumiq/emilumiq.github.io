---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Panel from '../components/Panel.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import StatusFilter from '../components/StatusFilter.astro';

const statuses = [
  { value: '', label: 'all' },
  { value: 'In progress', label: 'reading' },
  { value: 'Completed', label: 'completed' },
  { value: 'Planning', label: 'planning' },
  { value: 'Paused', label: 'paused' },
  { value: 'Dropped', label: 'dropped' },
];
---

<Base title="Reading · Emily">
  <main class="mx-auto w-full max-w-wide flex-1 px-4 py-3 pb-5">
    <h1 class="sr-only">reading</h1>
    <div class="mb-2 flex items-center justify-between gap-3">
      <a
        href="/"
        class="inline-flex min-h-11 items-center gap-1.5 text-meta font-medium text-accent transition-colors hover:text-accent-strong"
      >
        <Icon name="arrow-left" class="h-4 w-4" />
        home
      </a>
      <ThemeToggle />
    </div>
    <Panel title="reading" icon="book-open">
      <div class="flex items-center gap-3 pb-2">
        <StatusFilter statuses={statuses} />
        <span id="list-status" class="ms-auto text-caption text-faint tabular-nums" aria-live="polite">loading…</span>
      </div>
      <div id="list-grid" class="grid grid-cols-2 items-start gap-x-3 gap-y-3 pb-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"></div>
    </Panel>
  </main>
  <Footer />
</Base>

<script>
  import { initThemeToggle } from '../lib/icons';
  import { mountListPage } from '../lib/listPage';
  import { sortWatchlist } from '../lib/cards';
  import { fetchAniList } from '../lib/anilist';

  initThemeToggle();
  mountListPage({
    load: async () => {
      const anilist = await fetchAniList();
      return sortWatchlist(anilist.manga);
    },
    errorMessage: 'could not load the reading list',
  });
</script>
