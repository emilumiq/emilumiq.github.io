---
import Base from '../layouts/Base.astro';
---

<Base title="Watchlist · Emily">
  <main class="mx-auto w-full max-w-3xl px-6 py-10 sm:py-14">
    <a href="/" class="inline-flex text-base text-accent hover:text-accent-strong">← back</a>

    <div class="mt-8 flex items-end justify-between border-b border-line pb-4">
      <div>
        <p class="text-sm uppercase tracking-wide text-muted">library</p>
        <h1 class="mt-1 text-4xl font-bold text-foreground">watchlist</h1>
      </div>
      <span id="watchlist-status" class="text-sm text-muted" aria-live="polite">loading…</span>
    </div>

    <nav class="mt-6 flex gap-1" aria-label="Status filter">
      <button data-status="" class="status-tab status-tab-active rounded-md px-4 py-2 text-sm font-medium">All</button>
      <button data-status="1" class="status-tab status-tab-inactive rounded-md px-4 py-2 text-sm font-medium">In progress</button>
      <button data-status="2" class="status-tab status-tab-inactive rounded-md px-4 py-2 text-sm font-medium">Completed</button>
      <button data-status="3" class="status-tab status-tab-inactive rounded-md px-4 py-2 text-sm font-medium">Planning</button>
    </nav>

    <div id="watchlist-grid" class="mt-6 grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-4"></div>
    <div id="sentinel" class="h-1" />
  </main>
</Base>

<script>
  import { createCard, showFallback } from '../lib/cards';
  import { createWatchlistLoader } from '../lib/yamtrack';

  const grid = document.getElementById('watchlist-grid') as HTMLElement | null;
  const statusEl = document.getElementById('watchlist-status') as HTMLElement | null;
  const sentinel = document.getElementById('sentinel') as HTMLElement | null;

  if (!grid || !statusEl || !sentinel) throw new Error('Missing DOM elements');

  let currentStatus = '';
  let loading = false;
  let finished = false;
  const loaders: Record<string, ReturnType<typeof createWatchlistLoader>> = {};

  function getLoader(status: string) {
    if (!loaders[status]) loaders[status] = createWatchlistLoader(status);
    return loaders[status];
  }

  function setTabStyles(active: string) {
    document.querySelectorAll<HTMLButtonElement>('.status-tab').forEach((btn) => {
      const isActive = (btn.dataset.status ?? '') === active;
      btn.className =
        `status-tab rounded-md px-4 py-2 text-sm font-medium ${isActive ? 'status-tab-active' : 'status-tab-inactive'}`;
    });
  }

  function reset() {
    grid.innerHTML = '';
    loading = false;
    finished = false;
    sentinel.hidden = false;
  }

  document.querySelectorAll<HTMLButtonElement>('.status-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = btn.dataset.status ?? '';
      if (next === currentStatus) return;
      currentStatus = next;
      reset();
      setTabStyles(currentStatus);
      loadMore();
    });
  });

  async function loadMore() {
    if (loading || finished) return;
    loading = true;
    statusEl.textContent = 'loading…';

    try {
      const loader = getLoader(currentStatus);
      const { entries, done } = await loader.next();
      finished = done;

      if (entries.length === 0 && grid.children.length === 0) {
        showFallback(grid, 'nothing here');
      } else {
        const frag = document.createDocumentFragment();
        entries.forEach((item) => frag.append(createCard(item, 'grid')));
        grid.append(frag);
      }

      sentinel.hidden = finished;
      statusEl.textContent = grid.children.length ? '' : 'nothing here';
    } catch (err) {
      statusEl.textContent = err instanceof Error ? err.message : 'could not load';
    } finally {
      loading = false;
    }
  }

  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting && !loading && !finished) loadMore();
    },
    { rootMargin: '400px' },
  );
  observer.observe(sentinel);

  loadMore();
</script>
